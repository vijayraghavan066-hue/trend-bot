# Same Binance.US account as DASH/XRP/UNI/HBAR (account-scoped keys),
# fully separate .env/state/service.
BINANCE_US_API_KEY=
BINANCE_US_API_SECRET=

# Weekly, volatility-targeted trend-following across BTC/ETH/SOL. Not a
# grid bot -- see PROJECT_STATUS.md "Different asset class research" for
# the backtest this was built from. Risk-reduction tool (cuts drawdown in
# crashes), not an alpha strategy (gives up upside in monster bull runs).
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Validated shape: 4-week formation (long only if trailing 4w return > 0),
# vol-targeted sizing to 5% weekly vol, clipped 0.2x-1.0x (spot-only, no
# leverage), rebalanced weekly.
FORMATION_WEEKS=4
VOL_LOOKBACK_WEEKS=8
TARGET_VOL=0.05
MIN_EXPOSURE=0.2
MAX_EXPOSURE=1.0
REBALANCE_INTERVAL_DAYS=7

# Placeholder for dry-run -- no real capital decision made yet.
TOTAL_CAPITAL_USDT=300.0

POLL_INTERVAL_SECONDS=3600

# Safety switch. true = simulate orders only, no real trades placed.
DRY_RUN=true

STATE_FILE=state.json
LOG_FILE=logs/bot.log
LOG_LEVEL=INFO
HEARTBEAT_FILE=heartbeat.json
LEDGER_FILE=trades.csv
